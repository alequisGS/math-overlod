---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { getAtlas, nodeUrl } from '../lib/graph';
import { normalizedRelations } from '../lib/relations';
const nodes=(await getAtlas()).map(e=>e.data);
const datedPaper=nodes.find(n=>n.type==='paper' && n.timeline?.stage===2 && n.date);
const paperDate=datedPaper?.date ? new Intl.DateTimeFormat('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(`${datedPaper.date}T00:00:00Z`)) : 'A public record';
const stages=[{label:'The background',title:'Periods and mirror symmetry',note:'Thematic starting point'}, {label:'A geometric anchor',title:'The surface X₁₀',note:'The concrete example'}, {label:paperDate,title:'A categorical structure emerges',note:datedPaper?.dateNote ?? 'Date not supplied'}, {label:'The next question',title:'From the Euler form to genus',note:'Conceptual continuation · undated'}, {label:'New testing grounds',title:'Families and generalizations',note:'Research directions · undated'}];
const featured=nodes.filter(n=>n.timeline);
---
<BaseLayout title="Development of a research program" active="Timeline">
  <div class="page-width document-intro"><p class="eyebrow">Research in development</p><h1>How one question<br /><em>becomes another.</em></h1><p>An experimental timeline of ideas, branching from periods through X₁₀ to categorical genus.</p><p class="timeline-note">This is a conceptual sequence, not a dated history of discovery. Only the preprint has a verified calendar date. Stages and connections come from the content records.</p></div>
  <div class="timeline page-width">{stages.map((s,i)=><section class="timeline-stage"><div class="timeline-label"><span class="stage-number">0{i+1}</span><span class="eyebrow">{s.label}</span><p>{s.note}</p></div><div class="timeline-content"><h2>{s.title}</h2><div class="timeline-branches">{featured.filter(n=>n.timeline!.stage===i).map(n=><article><code>{n.id}</code><h3><a href={nodeUrl(n.id)}>{n.shortTitle}</a></h3><StatusBadge status={n.status}/><p>{n.timeline!.note}</p>{normalizedRelations(n).filter(r=>r.type==='motivates').map(r=><a class="timeline-connection" href={nodeUrl(r.target)}>motivates → {nodes.find(n=>n.id===r.target)!.shortTitle}</a>)}</article>)}</div></div></section>)}</div>
  <div class="page-width timeline-outro"><p class="eyebrow">Research has a history</p><h2>The next change belongs in Git.</h2><p>Statements, status changes and new relationships are recorded alongside the mathematics. A conjecture can become a result without losing its address.</p><a class="text-link" href="https://github.com/alequisGS/math-overlod/commits/main/">Explore the repository history ↗</a></div>
</BaseLayout>
