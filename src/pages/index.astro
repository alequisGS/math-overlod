---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchGraph from '../components/ResearchGraph.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { getAtlas, graphData, url, nodeUrl } from '../lib/graph';
import { projects } from '../lib/model';
const nodes = (await getAtlas()).map(e => e.data);
const previewIds = ['X10-001','X10-STACK-001','X10-EC-001','X10-EUL-001','CATGEN-001','CATGEN-ANTI-001','HMS-001','X10-PER-001','HMS-PER-001'];
const result = nodes.find(n => n.id === 'X10-EC-001')!;
---
<BaseLayout>
  <section class="hero page-width">
    <div class="hero-kicker"><span class="eyebrow">A visual mathematical knowledge network</span><span class="edition">Research atlas / 001</span></div>
    <h1>The structure<br />behind <em>the paper.</em></h1>
    <div class="hero-bottom"><p>Ideas are connected.<br />Research should be, too.</p><div class="hero-actions"><a class="button button-ink" href={url('graph/')}>Explore the network <span aria-hidden="true">↗</span></a><a class="text-link" href="#research">Explore research <span aria-hidden="true">↓</span></a></div></div>
    <div class="hero-foot"><span>Alex Gomez <span class="muted">/ Mathematical Research Atlas</span></span><span>Algebraic geometry · Derived categories<br />Homological mirror symmetry · Arithmetic geometry</span></div>
  </section>
  <section id="research" class="research-section page-width">
    <div class="section-heading"><p class="eyebrow">Connected directions</p><p>One surface. Several ways of seeing.</p></div>
    {Object.entries(projects).map(([key,p], i) => <article class:list={['program',`program-${key}`]}>
      <span class="program-number">0{i+1}</span>
      <div class="program-title"><h2><a href={nodeUrl(p.anchor)}>{p.title}</a></h2><span class="eyebrow">{p.direction}</span></div>
      <div class="program-description"><p>{p.description}</p><a class="text-link" href={url(`graph/?project=${key}`)}>Trace this direction <span aria-hidden="true">↗</span></a></div>
    </article>)}
  </section>
  <section class="network-intro page-width">
    <div class="network-copy"><p class="eyebrow">A connected view</p><h2>Follow an idea.<br /><em>See what follows.</em></h2><p>The surface X₁₀ connects an exceptional collection to Euler forms, categorical questions, and the search for a mirror.</p><a class="text-link" href={url('graph/')}>Open the complete graph <span aria-hidden="true">↗</span></a><p class="small muted">A neighborhood of {previewIds.length} objects from the atlas. Select an object to read its mathematical page.</p></div>
    <ResearchGraph data={graphData(nodes.filter(n => previewIds.includes(n.id)))} compact selected="X10-001" label="X₁₀ as a bridge between categorical and mirror research" />
  </section>
  <section class="featured-result page-width"><div><p class="eyebrow">An anchor in the network</p><code>{result.id}</code><StatusBadge status={result.claimStatus} /></div><div><h2><a href={nodeUrl(result.id)}>The canonical stack of X₁₀ admits a full exceptional collection.</a></h2><p>From a singular surface to a finite set of categorical generators.</p><a class="text-link" href={nodeUrl(result.id)}>Read the mathematical object ↗</a><p class="small muted">Source-backed result · arXiv:2606.18238 · Proof attributed to the preprint</p></div></section>
  <section class="about page-width"><p class="eyebrow">What is this?</p><div><h2>A paper tells a story.<br />An atlas reveals its structure.</h2><p>A mathematical paper presents research as a linear document. Math Overlord experiments with representing the structure behind the paper: ideas, examples, results, dependencies, conjectures and research programs.</p><p>Each object has a permanent address, explicit relationships and a visible epistemic status. The text and the graph are two ways into the same mathematics.</p><a class="text-link" href={url('index/')}>Read the mathematical index ↗</a></div></section>
</BaseLayout>
