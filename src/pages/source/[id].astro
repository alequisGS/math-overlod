---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAtlas, nodeUrl, url } from '../../lib/graph';
import { inspectSourceFragment, sourceAttestations, sourceFragments } from '../../lib/provenance';
import { sourceLinks } from '../../lib/source-links';

export function getStaticPaths() {
  return sourceFragments.map(fragment => ({ params: { id: fragment.id }, props: { fragment } }));
}
const { fragment } = Astro.props;
const nodes = (await getAtlas()).map(entry => entry.data);
const byId = new Map(nodes.map(node => [node.id, node]));
const attestations = sourceAttestations.filter(attestation => attestation.fragment === fragment.id);
const freshness = inspectSourceFragment(fragment);
const links = sourceLinks({
  repository: fragment.source.repository,
  branch: fragment.source.branch,
  commit: fragment.source.commit,
  path: fragment.source.file,
  startLine: fragment.selection.startLine,
  endLine: fragment.selection.endLine,
});
---
<BaseLayout title={`Source fragment ${fragment.id}`} description="Documentary source fragment">
  <article class="source-fragment-page page-width">
    <p class="breadcrumbs"><a href={url('index/')}>Index</a> / Source fragment</p>
    <header class="document-intro">
      <p class="eyebrow">Documentary evidence</p>
      <h1>Source fragment</h1>
      <p class="lede"><code>{fragment.id}</code></p>
    </header>
    <section class="source-fragment-card">
      <h2>Paper / repository</h2>
      <dl class="source-metadata">
        <dt>Paper</dt><dd>{fragment.context.paperTitle}</dd>
        <dt>Repository</dt><dd>{fragment.source.repository} · {fragment.source.branch}</dd>
        <dt>Commit</dt><dd><code>{fragment.source.commit}</code></dd>
        <dt>File</dt><dd><code>{fragment.source.file}</code></dd>
        <dt>Container</dt><dd>{fragment.container.environment} {fragment.container.printedNumber} · <code>{fragment.container.latexLabel}</code></dd>
        <dt>Lines</dt><dd>{fragment.selection.startLine}–{fragment.selection.endLine}</dd>
      </dl>
      <p class="review-state">Snapshot {freshness.state}</p>
      {freshness.reasons.length>0&&<ul class="source-notice">{freshness.reasons.map(reason=><li>{reason}</li>)}</ul>}
      <h2>Selected source text</h2>
      <pre><code>{fragment.selection.selectedText}</code></pre>
      <h2>Context / inherited hypotheses</h2>
      <p>{fragment.context.statementScope}</p>
      <p>Source key: <code>{fragment.context.sourceKey}</code> · section: {fragment.context.section}</p>
      <p class="source-links"><a href={links.pinned}>Pinned GitHub source ↗</a><a href={links.current}>Current source ↗</a><a href={links.history}>Source history ↗</a></p>
    </section>
    <section class="source-attestations">
      <h2>Attests</h2>
      {attestations.length?<ul>{attestations.map(attestation=><li><a href={url(`attestation/${attestation.id}/`)}><code>{attestation.id}</code></a> · {attestation.relation} · <a href={nodeUrl(attestation.target)}>{byId.get(attestation.target)?.title??attestation.target}</a></li>)}</ul>:<p class="muted">No reviewed attestations recorded.</p>}
    </section>
  </article>
</BaseLayout>
