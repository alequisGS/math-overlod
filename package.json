{
  "name": "math-overlord",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && tsc --noEmit",
    "build": "npm run check && astro build && node scripts/check-build.mjs",
    "preview": "astro preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "import:papers": "node --experimental-strip-types scripts/import-papers.ts papers",
    "import:paper": "node --experimental-strip-types scripts/import-papers.ts paper",
    "import:status": "node --experimental-strip-types scripts/import-papers.ts status",
    "import:accept": "node --experimental-strip-types scripts/import-papers.ts accept",
    "import:reject": "node --experimental-strip-types scripts/import-papers.ts reject",
    "import:relate": "node --experimental-strip-types scripts/import-papers.ts relate",
    "migrate:content": "node --experimental-strip-types scripts/migrate-content.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/mdx": "8.0.1",
    "astro": "7.3.2",
    "cytoscape": "^3.33.1",
    "katex": "^0.16.22",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/node": "^24.13.4",
    "typescript": "^5.9.3"
  }
}
